#!/bin/sh

# 300_gh_notifications - Byobu status widget: count unread GitHub notifications.
#
# Shows the total (✉), plus how many are aimed at you personally (@):
# mentions, review requests, and assignments.
#
# Note: This prints the previous result and refreshes it in the background,
# so a slow or offline network never stalls the status bar.

cache="${XDG_CACHE_HOME:-$HOME/.cache}/byobu/gh_notifications"

read -r total personal 2>/dev/null < "$cache"
if [ "${total:-0}" -gt 0 ]; then
  test "$total" -ge 100 && total=99+
  test "${personal:-0}" -gt 0 && printf '@%s ' "$personal"
  printf '✉%s\n' "$total"
fi

command -v gh >/dev/null || exit 0
mkdir -p "$(dirname "$cache")"
(
  gh api 'notifications?per_page=100' --jq '"\(length) \(map(select(.reason |
    IN("mention", "team_mention", "review_requested", "assign"))) | length)"' \
    > "$cache.tmp" &&
  mv "$cache.tmp" "$cache"
) </dev/null >/dev/null 2>&1 &
