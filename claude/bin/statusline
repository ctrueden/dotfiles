#!/bin/sh

# Prints a Claude Code status line: user@host, current directory and git branch.
# Configure via ~/.claude/settings.json: "statusLine": {"type": "command",
# "command": "~/code/ctrueden/dotfiles/bin/agents/claude-statusline"}

input=$(cat)
dir=$(printf '%s' "$input" | jq -r '.workspace.current_dir // .cwd // empty')
[ -n "$dir" ] || dir=$(pwd)

case "$dir" in
  "$HOME") short="~" ;;
  "$HOME"/*) short="~${dir#"$HOME"}" ;;
  *) short="$dir" ;;
esac

branch=$(GIT_OPTIONAL_LOCKS=0 git -C "$dir" symbolic-ref --short -q HEAD 2>/dev/null \
  || GIT_OPTIONAL_LOCKS=0 git -C "$dir" rev-parse --short HEAD 2>/dev/null)

printf '\033[1;32m%s@%s\033[0m \033[1;34m%s\033[0m' "$(whoami)" "$(hostname -s)" "$short"
[ -n "$branch" ] && printf ' \033[1;33m(%s)\033[0m' "$branch"
printf '\n'
