#!/bin/sh

# Installs a pinned juliaup portable release into ~/.local/opt, verified
# against the SHA-256 GitHub records for the release asset, and links julia
# and juliaup into ~/.local/bin. Used instead of the official installer, which
# is unpinned and adds juliaup's own dir to the PATH via shell rc blocks.
# Julia versions themselves live in ~/.julia/juliaup, managed by juliaup.
# A portable juliaup cannot update itself: to upgrade, bump juliaup_ver and the
# hashes together; GitHub shows each asset's SHA-256 on the release page, and
# as its digest via https://api.github.com/repos/JuliaLang/juliaup/releases/tags/vVERSION
#
# Platforms: linux
#
# With --check, reports via exit code whether the pinned version is linked.

. "${DOTFILES:?}/lib/download.sh"

juliaup_ver=1.23.0

opt="$HOME/.local/opt"
bin="$HOME/.local/bin"
dir="$opt/juliaup-$juliaup_ver"

if [ "${1:-}" = --check ]; then
  test "$(readlink "$bin/juliaup")" = "$dir/juliaup" &&
  test "$(readlink "$bin/julia")" = "$dir/julia"
  exit
fi

case "$(uname -m)" in
  x86_64)
    target=x86_64-unknown-linux-musl
    sha=5d5078d5ec5d92874e21122ffd9f4c36e42f913debbd73a560c55fce63c39a8a ;;
  aarch64|arm64)
    target=aarch64-unknown-linux-musl
    sha=0f9f508eb1f9c5eab1646caa165d14139277bbe2cd8d2fab8d7ba5c00a6a54d5 ;;
  *)
    echo "Unsupported architecture for juliaup: $(uname -m)" >&2
    exit 1 ;;
esac

download_verified "https://github.com/JuliaLang/juliaup/releases/download/v$juliaup_ver/juliaup-$juliaup_ver-$target-portable.tar.gz" "$sha" &&
rm -rf "$dir" && mkdir -p "$dir" "$bin" &&
tar -xzf "$downloaded" -C "$dir" &&
ln -sfn "$dir/juliaup" "$bin/juliaup" &&
ln -sfn "$dir/julia" "$bin/julia" || exit 1

# Remove any versions this one replaces.
for d in "$opt"/juliaup-*; do
  test "$d" = "$dir" || rm -rf "$d"
done

# Install the release channel, unless some Julia is installed already.
"$bin/juliaup" status 2>/dev/null | grep -q '^ *\*' ||
  "$bin/juliaup" add release
