#!/bin/sh

# Installs the GitHub CLI from its official apt repository (the distro package
# lags behind). Adapted from:
# https://github.com/cli/cli/blob/trunk/docs/install_linux.md
#
# Platforms: linux
#
# With --check, reports via exit code whether gh is installed with GitHub's
# repository configured; once it is, apt keeps it up to date. A gh from the
# distro alone does not count, so that this replaces it.

set -eu

keyring=/etc/apt/keyrings/githubcli-archive-keyring.gpg
sources=/etc/apt/sources.list.d/github-cli.list

if [ "${1:-}" = --check ]; then
  command -v gh >/dev/null && test -e "$keyring" -a -e "$sources"
  exit
fi

# Known-good fingerprints: https://github.com/cli/cli/blob/trunk/docs/install_linux.md
fp1=2C6106201985B60E6C7AC87323F3D4EA75716059
fp2=7F38BBB59D064DBCB3D84D725612B36462313325

SUDO=sudo
test "$(id -u)" -eq 0 && SUDO=

if [ ! -e "$keyring" ]; then
  key=$(mktemp)
  trap 'rm -f "$key"' EXIT
  curl -fsSL -o "$key" https://cli.github.com/packages/githubcli-archive-keyring.gpg
  gpg --show-keys "$key" | grep -q "$fp1"
  gpg --show-keys "$key" | grep -q "$fp2"
  $SUDO mkdir -p -m 755 /etc/apt/keyrings
  $SUDO tee "$keyring" < "$key" >/dev/null
  $SUDO chmod go+r "$keyring"
fi

$SUDO mkdir -p -m 755 /etc/apt/sources.list.d
echo "deb [arch=$(dpkg --print-architecture) signed-by=$keyring] https://cli.github.com/packages stable main" |
  $SUDO tee "$sources" >/dev/null
$SUDO apt-get update
$SUDO apt-get install -y gh
