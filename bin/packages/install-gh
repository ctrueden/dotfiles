#!/bin/sh

# Installs the GitHub CLI from its official apt repository (the distro package
# lags behind). Adapted from:
# https://github.com/cli/cli/blob/trunk/docs/install_linux.md
#
# Platforms: linux
#
# With --check, reports via exit code whether gh is installed with GitHub's
# repository configured; once it is, apt keeps it up to date. A gh from the
# distro alone does not count, so that this replaces it.

set -eu

. "${DOTFILES:?}/lib/apt-repo.sh"

keyring=/etc/apt/keyrings/githubcli-archive-keyring.gpg
sources=/etc/apt/sources.list.d/github-cli.list

if [ "${1:-}" = --check ]; then
  command -v gh >/dev/null && test -e "$keyring" -a -e "$sources"
  exit
fi

apt_repo_require

# Known-good fingerprints: https://github.com/cli/cli/blob/trunk/docs/install_linux.md
apt_repo_key https://cli.github.com/packages/githubcli-archive-keyring.gpg "$keyring" \
  2C6106201985B60E6C7AC87323F3D4EA75716059 \
  7F38BBB59D064DBCB3D84D725612B36462313325
apt_repo_file "$sources" \
  "deb [arch=$(dpkg --print-architecture) signed-by=$keyring] https://cli.github.com/packages stable main"
$SUDO apt-get update
$SUDO apt-get install -y gh
