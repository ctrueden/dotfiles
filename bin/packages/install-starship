#!/bin/sh

# Installs a pinned starship release binary into ~/.local/bin, verified against
# a SHA-256 recorded here. Used where the OS package is unavailable (Ubuntu
# older than 25.04, or FreeBSD without pkg, e.g. TrueNAS). To upgrade, bump
# starship_ver and all hashes together; the hashes are published as .sha256
# files beside each release asset.
#
# Platforms: linux freebsd
#
# With --check, reports via exit code whether the pinned version is installed.

. "${DOTFILES:?}/lib/download.sh"

starship_ver=1.27.0

if [ "${1:-}" = --check ]; then
  "$HOME/.local/bin/starship" --version 2>/dev/null |
    grep -qF "starship $starship_ver"
  exit
fi

case "$(uname)-$(uname -m)" in
  Linux-x86_64)
    target=x86_64-unknown-linux-musl
    sha=10c8eb4cb3b761d9bf59ea828444c2dab36c900b7d69a69e08814b286969df89 ;;
  Linux-aarch64|Linux-arm64)
    target=aarch64-unknown-linux-musl
    sha=341f5cbf24699fa0b27ec88965ad25f862ea09e15d35a543fd6ffdff1d2aa00d ;;
  FreeBSD-amd64)
    target=x86_64-unknown-freebsd
    sha=2d0c8e495069a6f481aba2d7558645e1955c796db48529b796483cbe3f41848b ;;
  *)
    echo "Unsupported platform for starship: $(uname) $(uname -m)" >&2
    exit 1 ;;
esac

download_verified "https://github.com/starship/starship/releases/download/v$starship_ver/starship-$target.tar.gz" "$sha" &&
mkdir -p "$HOME/.local/bin" &&
tar -xzf "$downloaded" -C "$HOME/.local/bin" starship
