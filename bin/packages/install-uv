#!/bin/sh

# Installs a pinned uv release into ~/.local/bin via its official installer,
# verified against a SHA-256 recorded here. Used where no OS package exists.
#
# Unlike a bare binary, an installer-made uv writes the receipt that
# `uv self update` needs. The versioned installer verifies the archive it
# downloads against SHA-256s embedded in itself, so pinning the installer
# pins the whole chain. To upgrade, bump uv_ver and the hash together; no
# hash is published for the installer, so compute it with sha256sum.

. "$(dirname "$0")/lib.sh"

uv_ver=0.12.18
sha=e62a5ea089de9c6a9b1f767166c9f33194e18d350e9f375c6355fac3ba0fb42b

download_verified "https://github.com/astral-sh/uv/releases/download/$uv_ver/uv-installer.sh" "$sha" &&
UV_NO_MODIFY_PATH=1 sh "$downloaded"
