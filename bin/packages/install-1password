#!/bin/sh

# Installs 1Password from its official apt repository, along with the
# debsig-verify policy its packages are signed for. Adapted from:
# https://support.1password.com/install-linux/
#
# Platforms: linux
#
# With --check, reports via exit code whether 1Password is installed with its
# repository configured; once it is, apt keeps it up to date.

set -eu

. "${DOTFILES:?}/lib/apt-repo.sh"

repo=https://downloads.1password.com/linux/debian/amd64
keyring=/usr/share/keyrings/1password-archive-keyring.gpg

if [ "${1:-}" = --check ]; then
  apt_installed 1password && test -e "$keyring" && apt_repo_has "$repo"
  exit
fi

apt_repo_require
test "$(dpkg --print-architecture)" = amd64 || {
  echo "1Password's apt repository serves only amd64." >&2
  exit 1
}

# Known-good fingerprint: see the 1Password page above.
key=https://downloads.1password.com/linux/keys/1password.asc
fp=3FEF9748469ADBE15DA7CA80AC2D62742012EA22
apt_repo_key "$key" "$keyring" "$fp"
# Note: The package rewrites this entry in its own format on install.
apt_repo_has "$repo" ||
  apt_repo_sources 1password "$repo" stable main "$keyring" amd64

debsig=AC2D62742012EA22
apt_repo_key "$key" "/usr/share/debsig/keyrings/$debsig/debsig.gpg" "$fp"
policy=/etc/debsig/policies/$debsig/1password.pol
if [ ! -e "$policy" ]; then
  content=$(curl -fsSL https://downloads.1password.com/linux/debian/debsig/1password.pol)
  apt_repo_file "$policy" "$content"
fi

$SUDO apt-get update
$SUDO apt-get install -y 1password
