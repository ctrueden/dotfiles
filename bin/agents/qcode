#!/bin/sh

# Runs Qwen Code against a local Qwen3.8 model managed by shoehorn.

set -eu

usage() {
  cat <<EOF
Usage: qcode [--tier large|medium|small|flash-large|flash-medium] [-y|--yes] [--force] [--setup] [--status] [--cleanup] [-- QWEN_ARGS...]

Runs Qwen Code with a local Qwen model. On first use of standard tiers,
prompts for the machine type and usable model memory, then fits missing
models. Flash tiers download pre-quantized Qwen3.8-Flash-Next dynamic GGUFs.

Options:
  --tier TIER  Select tier:
                 flash-large   Qwen3.8-Flash-Next 125B MoE (128k context)
                 flash-medium  Qwen3.8-Flash-Next 125B MoE (64k context)
                 large         Local fit (128k context; default)
                 medium        Local fit (64k context)
                 small         Local fit (32k context; short answers)
               Aliases: flash, flash-128k -> flash-large; flash-64k -> flash-medium
  -y, --yes    Do not ask before fitting missing models.
  --force      Allow another local Qwen session to use the same server.
  --setup      Fit missing models, then exit.
  --status     Show the configured tiers and llama-server status.
  --cleanup    Delete cached unquantized source models, keeping imatrix data.
EOF
}

fail() {
  echo "qwen: $*" >&2
  exit 1
}

has() { command -v "$1" >/dev/null; }

config_home=${XDG_CONFIG_HOME:-$HOME/.config}
data_home=${XDG_DATA_HOME:-$HOME/.local/share}
state_home=${XDG_STATE_HOME:-$HOME/.local/state}
config_dir="$config_home/qwen-local"
config="$config_dir/config"
models="$data_home/llm/models"
# Note: shoehorn hardcodes $HOME/.cache/shoehorn and ignores XDG_CACHE_HOME.
cache_dir="$HOME/.cache/shoehorn"
state_dir="$state_home/qwen-local"
pid_file="$state_dir/llama-server.pid"
model_file="$state_dir/llama-server.model"
log_file="$state_dir/llama-server.log"
port=8080
tier=large
yes=
force=
setup=
status=
cleanup=

while [ $# -gt 0 ]; do
  case "$1" in
    --tier)
      shift
      test $# -gt 0 || fail "--tier needs large, medium, small, flash-large, or flash-medium"
      tier=$1 ;;
    -y|--yes) yes=1 ;;
    --force) force=1 ;;
    --setup) setup=1 ;;
    --status) status=1 ;;
    --cleanup) cleanup=1 ;;
    -h|--help) usage; exit ;;
    --) shift; break ;;
    *) break ;;
  esac
  shift
done

# Normalize tier aliases
case "$tier" in
  smart) tier=large ;;
  balanced) tier=medium ;;
  fast) tier=small ;;
  flash|flash-128k) tier=flash-large ;;
  flash-64k) tier=flash-medium ;;
esac

case "$tier" in
  large|medium|small|flash-large|flash-medium) ;;
  *) fail "unknown tier: $tier" ;;
esac

script_dir=$(CDPATH= cd -- "$(dirname "$0")" && pwd)

find_qwen() {
  for candidate in "$HOME"/.local/opt/qwen-code-*/bin/qwen; do
    test -x "$candidate" || continue
    printf '%s\n' "$candidate"
    return 0
  done

  saved_ifs=$IFS
  IFS=:
  for entry in $PATH; do
    test -n "$entry" || entry=.
    candidate_dir=$(CDPATH= cd -- "$entry" 2>/dev/null && pwd) || continue
    test "$candidate_dir" = "$script_dir" && continue
    candidate="$candidate_dir/qwen"
    test -x "$candidate" || continue
    printf '%s\n' "$candidate"
    IFS=$saved_ifs
    return 0
  done
  IFS=$saved_ifs
  return 1
}

qwen_bin=$(find_qwen) || fail "Qwen Code is not installed; run 'pack --with ai' first"
has shoehorn || fail "shoehorn is not installed; run 'pack --with ai' first"
has llama-server || fail "llama.cpp is not installed; run 'pack --with ai' first"
has curl || fail "curl is required"
# Note: checked up front, since a missing checksum tool must not be mistaken
# for a checksum mismatch and delete a downloaded shard.
has sha256sum || fail "sha256sum is required"
has node || fail "Node.js is required to configure Qwen Code; run 'pack' first"

prompt() { # prompt default
  test -t 0 || fail "initial hardware setup needs an interactive terminal"
  printf '%s [%s] ' "$1" "$2" >&2
  read -r answer </dev/tty
  test -n "$answer" && printf '%s\n' "$answer" || printf '%s\n' "$2"
}

configure_hardware() {
  mkdir -p "$config_dir"
  backend=$(prompt "Backend (macos or nvidia)?" "$(uname | grep -q Darwin && echo macos || echo nvidia)")
  case "$backend" in macos|nvidia) ;; *) fail "backend must be macos or nvidia" ;; esac
  case "$backend" in
    macos) memory_prompt="Total unified memory in GiB?" ;;
    nvidia) memory_prompt="Total NVIDIA VRAM in GiB? (use the card's advertised capacity)" ;;
  esac
  memory_gib=$(prompt "$memory_prompt" "")
  case "$memory_gib" in *[!0-9]*|'') fail "memory must be a whole number of GiB" ;; esac

  case "$backend" in
    macos)
      if [ "$memory_gib" -ge 64 ]; then
        large_repo=empero-ai/Qwen3.8-35B-A3B-Distill-GGUF
        medium_repo=empero-ai/Qwen3.8-9B-Distill-GGUF
        small_repo=empero-ai/Qwen3.8-4B-Distill-GGUF
      else
        large_repo=empero-ai/Qwen3.8-9B-Distill-GGUF
        medium_repo=empero-ai/Qwen3.8-4B-Distill-GGUF
        small_repo=empero-ai/Qwen3.8-2B-Distill-GGUF
      fi
      kv=f16
      medium_budget=
      reserve=12GiB
      ;;
    nvidia)
      if [ "$memory_gib" -le 8 ]; then
        large_repo=empero-ai/Qwen3.8-4B-Distill-GGUF
        medium_repo=empero-ai/Qwen3.8-4B-Distill-GGUF
        small_repo=empero-ai/Qwen3.8-2B-Distill-GGUF
        kv=q8_0
        medium_budget=6GiB
        reserve=1GiB
      elif [ "$memory_gib" -le 15 ]; then
        large_repo=empero-ai/Qwen3.8-4B-Distill-GGUF
        medium_repo=empero-ai/Qwen3.8-4B-Distill-GGUF
        small_repo=empero-ai/Qwen3.8-2B-Distill-GGUF
        kv=q8_0
        medium_budget=
        reserve=1GiB
      else
        large_repo=empero-ai/Qwen3.8-9B-Distill-GGUF
        medium_repo=empero-ai/Qwen3.8-4B-Distill-GGUF
        small_repo=empero-ai/Qwen3.8-2B-Distill-GGUF
        kv=q8_0
        medium_budget=
        reserve=1GiB
      fi
      ;;
  esac

  cat > "$config.tmp" <<EOF
backend=$backend
memory_gib=$memory_gib
large_repo=$large_repo
medium_repo=$medium_repo
small_repo=$small_repo
kv=$kv
medium_budget=$medium_budget
reserve=$reserve
EOF
  mv "$config.tmp" "$config"
}

test -f "$config" || configure_hardware
. "$config"

large_repo=${large_repo:-${smart_repo:-empero-ai/Qwen3.8-35B-A3B-Distill-GGUF}}
medium_repo=${medium_repo:-${balanced_repo:-empero-ai/Qwen3.8-9B-Distill-GGUF}}
small_repo=${small_repo:-${fast_repo:-empero-ai/Qwen3.8-4B-Distill-GGUF}}
medium_budget=${medium_budget:-${balanced_budget:-}}
reserve=${reserve:-12GiB}

tier_repo() {
  case "$1" in
    large) printf '%s\n' "$large_repo" ;;
    medium) printf '%s\n' "$medium_repo" ;;
    small) printf '%s\n' "$small_repo" ;;
    flash-large|flash-medium) printf '%s\n' "unsloth/Qwen3.8-Flash-Next-GGUF" ;;
  esac
}

tier_budget() {
  case "$1" in medium) printf '%s\n' "$medium_budget" ;; *) printf '\n' ;; esac
}

tier_context() {
  case "$1" in
    large|flash-large) printf '%s\n' 131072 ;;
    medium|flash-medium) printf '%s\n' 65536 ;;
    small) printf '%s\n' 32768 ;;
  esac
}

tier_kv() {
  case "$1" in
    flash-large|flash-medium) printf '%s\n' q8_0 ;;
    *) printf '%s\n' "$kv" ;;
  esac
}

flash_base_dir="$models/qwen38-flash-next"
# Note: pinned to a commit, so that a resumed download can never splice two
# revisions of a shard together the way a mutable branch would.
flash_commit=766911a6b7369840a91dbcd95f9f997acaab6cd6
flash_base_url="https://huggingface.co/unsloth/Qwen3.8-Flash-Next-GGUF/resolve/$flash_commit"

# One entry per file as "<path> <size> <sha256>". Refresh the sizes and hashes
# from the tree API, whose lfs.oid is the file's sha256:
#   curl -fsS "https://huggingface.co/api/models/unsloth/Qwen3.8-Flash-Next-GGUF/tree/$flash_commit/UD-Q3_K_XL" |
#     jq -r '.[] | [.path, .size, .lfs.oid] | "@ \"\(.path) \(.size) \(.lfs.oid)\""'
flash_manifest() {
  cat <<'EOF'
UD-Q3_K_XL/Qwen3.8-Flash-Next-UD-Q3_K_XL-00001-of-00003.gguf 10946624 f2ef4328929d8b8c8930e2856eef52128dd4ce3425302f04bc3c657431cc4c49
UD-Q3_K_XL/Qwen3.8-Flash-Next-UD-Q3_K_XL-00002-of-00003.gguf 49983253824 7d230e7c9421d868b89eebaf23033af0ea1a4e046956df00fb156814fb62346e
UD-Q3_K_XL/Qwen3.8-Flash-Next-UD-Q3_K_XL-00003-of-00003.gguf 39992153376 21d4f90f9cd7b7c3a1582667c20cb22f7b03de895b88a23bb20aaeaa44f2c199
EOF
  # MTP: add MTP/mtp-Qwen3.8-Flash-Next-shared-Q8_0.gguf 2786568256 5ff54097406a905cf3a724c709124ceb0e3e10235ee862298969e91c96fa96e6
}

tier_model() {
  case "$1" in
    flash-large|flash-medium)
      printf '%s/UD-Q3_K_XL/Qwen3.8-Flash-Next-UD-Q3_K_XL-00001-of-00003.gguf\n' "$flash_base_dir" ;;
    *)
      model_context=$(tier_context "$1")
      printf '%s/qwen38-%s-%s-%sg-%sk.gguf\n' \
        "$models" "$1" "$backend" "$memory_gib" "$((model_context / 1024))" ;;
  esac
}

# Note: MTP is disabled until stock llama.cpp can load the shared MTP GGUF.
# It omits token_embd.weight (shared with the main model), which needs the
# custom branch https://github.com/danielhanchen/llama.cpp (qwen4exp/mtp).
# To re-enable once llama.cpp supports it: restore the case below, and uncomment
# the MTP entry in flash_manifest, which both the install check and the download
# loop read.
tier_mtp_model() {
  printf '\n'
  # case "$1" in
  #   flash-large|flash-medium)
  #     printf '%s/MTP/mtp-Qwen3.8-Flash-Next-shared-Q8_0.gguf\n' "$flash_base_dir" ;;
  #   *)
  #     printf '\n' ;;
  # esac
}

file_size() { # path -- 0 when the file is absent
  test -f "$1" && wc -c < "$1" | tr -d ' ' || printf '0'
}

flash_shard_complete() { # path size
  test "$(file_size "$flash_base_dir/$1")" = "$2"
}

flash_models_installed() {
  while read -r file size sha; do
    flash_shard_complete "$file" "$size" || return 1
  done <<EOF
$(flash_manifest)
EOF
  # MTP: the entry in flash_manifest covers the MTP file once it is enabled.
}

# Note: checksums are only spent on bytes fetched now; a file that already has
# its pinned size is trusted, so --status and startup stay fast on full installs.
download_flash_models() {
  flash_models_installed && return 0

  if [ -z "$yes" ]; then
    test -t 0 || fail "model setup needs an interactive terminal; rerun with -y"
    printf 'Downloading Qwen3.8-Flash-Next (UD-Q3_K_XL, ~90GB). Continue? [y/N] ' >&2
    read -r answer </dev/tty
    case "$answer" in y|Y|yes|YES) ;; *) exit 0 ;; esac
  fi

  mkdir -p "$flash_base_dir"
  while read -r file size sha; do
    dest="$flash_base_dir/$file"
    flash_shard_complete "$file" "$size" && continue
    mkdir -p "$(dirname "$dest")"
    # Note: a shard longer than the pinned one cannot be resumed from, since
    # curl would ask for a range past the end of the file and fail on every rerun.
    test "$(file_size "$dest")" -le "$size" || rm -f "$dest"
    # Note: -C - resumes a partial shard. Stitching resumed bytes onto a
    # re-uploaded file is the risk the pinned commit and checksum below rule out.
    curl -fL -C - --progress-bar -o "$dest" "$flash_base_url/$file" ||
      fail "interrupted; rerun qcode to resume $file"
    flash_shard_complete "$file" "$size" || fail "unexpected size for $file"
    test "$(sha256sum "$dest" | cut -d' ' -f1)" = "$sha" || {
      rm -f "$dest"
      fail "checksum mismatch for $file"
    }
  done <<EOF
$(flash_manifest)
EOF
}

fit_missing_models() {
  case "$tier" in
    flash-large|flash-medium)
      download_flash_models
      return ;;
  esac

  missing=
  for requested_tier in large medium small; do
    test -f "$(tier_model "$requested_tier")" ||
      missing="${missing}${missing:+ }${requested_tier}"
  done
  test -z "$missing" && return

  if [ -z "$yes" ]; then
    test -t 0 || fail "model setup needs an interactive terminal; rerun with -y"
    printf 'Fitting local Qwen models (%s) may take a long time and download large files. Continue? [y/N] ' "$missing" >&2
    read -r answer </dev/tty
    case "$answer" in y|Y|yes|YES) ;; *) exit 0 ;; esac
  fi

  mkdir -p "$models"
  for requested_tier in large medium small; do
    model=$(tier_model "$requested_tier")
    test -f "$model" && continue
    repo=$(tier_repo "$requested_tier")
    budget=$(tier_budget "$requested_tier")
    model_context=$(tier_context "$requested_tier")
    shoehorn fit "$repo" --ctx "$model_context" --kv "$kv" \
      --reserve "$reserve" --output "$model" \
      ${budget:+--budget "$budget"}
  done
}

server_healthy() {
  curl -fsS --connect-timeout 1 --max-time 2 \
    "http://127.0.0.1:$port/health" >/dev/null 2>&1
}

stop_managed_server() {
  test -f "$pid_file" || return
  server_pid=$(cat "$pid_file" 2>/dev/null || true)
  case "$server_pid" in *[!0-9]*|'') rm -f "$pid_file" "$model_file"; return ;; esac
  kill -0 "$server_pid" 2>/dev/null || {
    rm -f "$pid_file" "$model_file"
    return
  }
  kill "$server_pid"
  while kill -0 "$server_pid" 2>/dev/null; do sleep 1; done
  rm -f "$pid_file" "$model_file"
}

start_server() {
  requested_model=$(tier_model "$tier")
  requested_context=$(tier_context "$tier")
  requested_kv=$(tier_kv "$tier")
  server_key="$tier:$requested_model:$requested_context"
  if test -f "$pid_file" && test -f "$model_file" &&
    test "$(cat "$model_file")" = "$server_key" && server_healthy
  then
    return
  fi

  test -f "$pid_file" && stop_managed_server
  server_healthy &&
    fail "port $port is in use by a llama-server not managed by this wrapper"

  mkdir -p "$state_dir"

  mtp_model=$(tier_mtp_model "$tier")
  if [ -n "$mtp_model" ]; then
    llama-server -m "$requested_model" -c "$requested_context" -ngl 99 \
      --cache-type-k "$requested_kv" --cache-type-v "$requested_kv" -np 1 -fa on \
      -md "$mtp_model" --spec-type draft-mtp --spec-draft-n-max 5 -ngld 99 \
      --temp 1.0 --top-p 0.95 --top-k 20 --min-p 0.0 \
      --chat-template-kwargs '{"reasoning_effort":"medium"}' \
      --alias "dotfiles-local-llama-$tier" \
      --host 127.0.0.1 --port "$port" > "$log_file" 2>&1 &
  else
    case "$tier" in
      flash-large|flash-medium)
        llama-server -m "$requested_model" -c "$requested_context" -ngl 99 \
          --cache-type-k "$requested_kv" --cache-type-v "$requested_kv" -np 1 -fa on \
          --temp 1.0 --top-p 0.95 --top-k 20 --min-p 0.0 \
          --chat-template-kwargs '{"reasoning_effort":"medium"}' \
          --alias "dotfiles-local-llama-$tier" \
          --host 127.0.0.1 --port "$port" > "$log_file" 2>&1 &
        ;;
      *)
        llama-server -m "$requested_model" -c "$requested_context" -ngl 99 \
          --cache-type-k "$requested_kv" --cache-type-v "$requested_kv" -np 1 -fa on \
          --alias "dotfiles-local-llama-$tier" \
          --host 127.0.0.1 --port "$port" > "$log_file" 2>&1 &
        ;;
    esac
  fi
  server_pid=$!
  printf '%s\n' "$server_pid" > "$pid_file"
  printf '%s\n' "$server_key" > "$model_file"

  waited=0
  while ! server_healthy; do
    kill -0 "$server_pid" 2>/dev/null ||
      fail "llama-server exited; see $log_file"
    waited=$((waited + 1))
    test "$waited" -lt 120 ||
      fail "llama-server did not become ready; see $log_file"
    sleep 1
  done
}

configure_qwen() {
  settings="$HOME/.qwen/settings.json"
  mkdir -p "$(dirname "$settings")"
  node - "$settings" "$1" "$tier" <<'EOF'
const fs = require('fs');
const [settings, context, tier] = process.argv.slice(2);
const id = `dotfiles-local-llama-${tier}`;
let config = {};
try {
  config = JSON.parse(fs.readFileSync(settings, 'utf8'));
} catch (error) {
  if (error.code !== 'ENOENT') throw error;
}
config.model ??= {};
config.model.name = id;
// Note: the small model is too small to cope with project context files, so point
// Qwen Code at a context file name that does not exist (an empty name is ignored).
const noContext = ['-'];
config.context ??= {};
if (tier === 'small') {
  config.context.fileName = noContext;
} else if (JSON.stringify(config.context.fileName) === JSON.stringify(noContext)) {
  delete config.context.fileName;
}
config.modelProviders ??= {};
const providers = config.modelProviders.openai ?? [];
config.modelProviders.openai = providers.filter(
  provider => provider.id !== id && provider.id !== 'dotfiles-local-llama',
);
config.modelProviders.openai.push({
  id,
  name: `Local Qwen3.8 ${tier} (llama.cpp)`,
  baseUrl: 'http://127.0.0.1:8080/v1',
  envKey: 'DOTFILES_LOCAL_LLM_KEY',
  generationConfig: {
    contextWindowSize: Number(context),
    maxOutputTokens: 4096,
    timeout: 300000,
    streamIdleTimeoutMs: 600000,
  },
});
const temporary = `${settings}.tmp-${process.pid}`;
fs.writeFileSync(temporary, `${JSON.stringify(config, null, 2)}\n`, { mode: 0o600 });
fs.renameSync(temporary, settings);
EOF
}

human_size() { # bytes -- human readable size
  awk -v bytes="$1" 'BEGIN {
    n = split("B KiB MiB GiB TiB", units, " ")
    unit = 1
    while (bytes >= 1024 && unit < n) { bytes /= 1024; unit += 1 }
    if (unit == 1) printf "%d %s\n", bytes, units[unit]
    else printf "%.1f %s\n", bytes, units[unit]
  }'
}

# Note: recomputing an imatrix means llama-imatrix re-reads the source GGUF, so
# a cached imatrix is the cheap part of a re-fit. Keep it while freeing sources.
dir_source_bytes() { # dir -- bytes of unquantized GGUFs directly inside it
  bytes=0
  for file in "$1"/*.gguf; do
    test -f "$file" || continue
    case "$file" in *.imatrix.gguf) continue ;; esac
    bytes=$((bytes + $(file_size "$file")))
  done
  printf '%s\n' "$bytes"
}

remove_dir_sources() { # dir -- delete unquantized GGUFs, keep imatrix data
  for file in "$1"/*.gguf; do
    test -f "$file" || continue
    case "$file" in *.imatrix.gguf) continue ;; esac
    rm -f "$file"
  done
  rmdir "$1" 2>/dev/null || true
}

cache_source_bytes() { # -- unquantized source bytes in the shoehorn cache
  bytes=0
  test -d "$cache_dir" || { printf '0\n'; return; }
  for dir in "$cache_dir"/*/; do
    test -d "$dir" || continue
    bytes=$((bytes + $(dir_source_bytes "${dir%/}")))
  done
  printf '%s\n' "$bytes"
}

# Note: shoehorn keeps no record of which source backs which fit, so the source
# of an interrupted fit is indistinguishable from a consumed one; prompting per
# repo leaves that judgement to the user. Deleting one only costs a resumed
# re-download, since shoehorn fetches its sources with curl -C -.
cleanup_cache() {
  if ! test -d "$cache_dir"; then
    printf 'No shoehorn cache at %s\n' "$cache_dir"
    return
  fi
  command -v pgrep >/dev/null 2>&1 &&
    pgrep -f 'shoehorn fit' >/dev/null 2>&1 &&
    fail "a shoehorn fit is running; wait for it to finish"
  total=$(cache_source_bytes)
  if test "$total" -eq 0; then
    printf 'Nothing to reclaim in %s\n' "$cache_dir"
    return
  fi
  printf 'Reclaimable: %s of unquantized sources in %s\n' \
    "$(human_size "$total")" "$cache_dir"
  freed=0
  for dir in "$cache_dir"/*/; do
    test -d "$dir" || continue
    dir=${dir%/}
    bytes=$(dir_source_bytes "$dir")
    test "$bytes" -gt 0 || continue
    printf '\n%s (%s)\n' "$dir" "$(human_size "$bytes")"
    if [ -z "$yes" ]; then
      test -t 0 || fail "cleanup needs an interactive terminal; rerun with -y"
      printf '  Delete? [y/N] ' >&2
      read -r answer </dev/tty
      case "$answer" in y|Y|yes|YES) ;; *) printf '  kept\n'; continue ;; esac
    fi
    remove_dir_sources "$dir"
    freed=$((freed + bytes))
    printf '  freed %s\n' "$(human_size "$bytes")"
  done
  if test "$freed" -eq 0; then
    printf 'Nothing deleted.\n'
  else
    printf '\nFreed %s; kept imatrix and calibration data to speed up re-fits.\n' \
      "$(human_size "$freed")"
  fi
}

show_status() {
  printf 'Backend: %s, model memory: %s GiB, reserve: %s\n' \
    "$backend" "$memory_gib" "$reserve"
  for requested_tier in flash-large flash-medium large medium small; do
    model=$(tier_model "$requested_tier")
    model_context=$(tier_context "$requested_tier")
    case "$requested_tier" in
      flash-large|flash-medium)
        if flash_models_installed; then
          printf '%-13s %3sk %s\n' "$requested_tier:" \
            "$((model_context / 1024))" "$model"
        else
          printf '%-13s %3sk not downloaded\n' "$requested_tier:" \
            "$((model_context / 1024))"
        fi
        ;;
      *)
        if test -f "$model"; then
          printf '%-13s %3sk %s\n' "$requested_tier:" \
            "$((model_context / 1024))" "$model"
        else
          printf '%-13s %3sk not fitted\n' "$requested_tier:" \
            "$((model_context / 1024))"
        fi
        ;;
    esac
  done
  cache_bytes=$(cache_source_bytes)
  if test "$cache_bytes" -gt 0; then
    printf 'Cache: %s of unquantized sources in %s (qcode --cleanup)\n' \
      "$(human_size "$cache_bytes")" "$cache_dir"
  fi
  if test -f "$pid_file" && server_healthy; then
    printf 'Server: running (PID %s, %s)\n' "$(cat "$pid_file")" "$(cat "$model_file")"
  else
    printf 'Server: stopped\n'
  fi
}

if [ -n "$status" ]; then
  show_status
  exit
fi

if [ -n "$cleanup" ]; then
  cleanup_cache
  exit
fi

fit_missing_models
test -z "$setup" || exit 0

mkdir -p "$state_dir"
lock="$state_dir/qwen.lock"
requested_model=$(tier_model "$tier")
requested_context=$(tier_context "$tier")
server_key="$tier:$requested_model:$requested_context"
if [ -n "$force" ] && test -d "$lock"; then
  lock_pid=$(cat "$lock/pid" 2>/dev/null || true)
  case "$lock_pid" in
    *[!0-9]*|'') ;;
    *)
      if kill -0 "$lock_pid" 2>/dev/null; then
        test -f "$model_file" &&
          test "$(cat "$model_file")" = "$server_key" ||
          fail "--force can share only the tier already loaded by the active Qwen session"
      fi ;;
  esac
fi

if [ -z "$force" ]; then
  if ! mkdir "$lock" 2>/dev/null; then
    lock_pid=$(cat "$lock/pid" 2>/dev/null || true)
    case "$lock_pid" in
      *[!0-9]*|'')
        fail "another local Qwen session is initializing; retry shortly" ;;
    esac
    if kill -0 "$lock_pid" 2>/dev/null; then
      fail "another local Qwen session is active (PID $lock_pid); use --force to share the server"
    fi
    rm -f "$lock/pid"
    rmdir "$lock" 2>/dev/null ||
      fail "cannot clear stale local Qwen lock: $lock"
    mkdir "$lock" || fail "cannot create local Qwen lock: $lock"
  fi
  printf '%s\n' "$$" > "$lock/pid"
  trap 'rm -f "$lock/pid"; rmdir "$lock" 2>/dev/null || true' EXIT HUP INT TERM
fi

start_server
configure_qwen "$(tier_context "$tier")"

# Note: the small tier is for short answers; cap output so runaway text is cut off early.
test "$tier" != small || export QWEN_CODE_MAX_OUTPUT_TOKENS=1024

DOTFILES_LOCAL_LLM_KEY=local \
OPENAI_API_KEY=local \
OPENAI_BASE_URL="http://127.0.0.1:$port/v1" \
OPENAI_MODEL="dotfiles-local-llama-$tier" \
QWEN_MODEL="dotfiles-local-llama-$tier" \
"$qwen_bin" --model "dotfiles-local-llama-$tier" "$@"
qwen_status=$?

exit "$qwen_status"
