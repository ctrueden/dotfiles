#!/bin/sh

# Note: Abort the whole run on ^C, not just the step that was interrupted.
# Otherwise sudo's cancelled password prompt fails that step and the rest continue.
trap 'echo; echo "Interrupted."; exit 130' INT

# Note: Windows package managers prompt for elevation themselves, when needed,
# and nothing below needs sudo on FreeBSD.
case "$(uname)" in
  Linux|Darwin) sudo -v || exit 1 ;;
  FreeBSD|MINGW*|MSYS*|CYGWIN*) ;;
  *) echo "Unsupported OS: $(uname)" >&2; exit 1 ;;
esac

exit_code=0

if [ -d "$DOTFILES" ]
then
  echo
  echo "--== Updating dotfiles ==--"

  # Only use fast-forward merge, not rebase. If dotfiles
  # have diverged from remote, this returns non-zero by design.
  (cd "$DOTFILES" &&
    git fetch --all --tags --prune --jobs=10 &&
    git merge --ff --ff-only 'HEAD@{u}')
  code=$?; test $code -lt $exit_code || exit_code=$code
  test $code -eq 0 || echo "=> returned $code"
fi

if command -v zpm >/dev/null
then
  echo
  echo "--== Updating zsh plugins ==--"
  zpm up
  code=$?; test $code -lt $exit_code || exit_code=$code
  test $code -eq 0 || echo "=> returned $code"
fi

if [ -d "$CODE_SCIJAVA/scijava-scripts" ]
then
  echo
  echo "--== Updating SciJava scripts ==--"
  (cd "$CODE_SCIJAVA/scijava-scripts" && git pull --rebase)
  code=$?; test $code -lt $exit_code || exit_code=$code
  test $code -eq 0 || echo "=> returned $code"
fi

if [ -d "$HOME/.password-store" -a -x "$(command -v pass)" ]
then
  echo
  echo "--== Updating password store ==--"
  pass git pull --rebase
  code=$?; test $code -lt $exit_code || exit_code=$code
  test $code -eq 0 || echo "=> returned $code"
fi

if [ -x "$(command -v fwupdmgr)" ]; then
  echo
  echo "--== Updating firmware ==--"
  fwupdmgr get-updates
  code=$? #; test $code -lt $exit_code || exit_code=$code
  test $code -eq 0 || echo "=> returned $code"
  fwupdmgr update -y --no-reboot-check
  code=$? #; test $code -lt $exit_code || exit_code=$code
  test $code -eq 0 || echo "=> returned $code"
fi

if [ -x "$(command -v apt-get)" ]; then
  echo
  echo "--== Updating apt packages ==--"
  sudo apt-get update
  sudo apt-get dist-upgrade -y
  code=$?; test $code -lt $exit_code || exit_code=$code
  test $code -eq 0 || echo "=> returned $code"
fi

if [ -x "$(command -v flatpak)" ]; then
  echo
  echo "--== Updating Flatpak packages ==--"
  sudo flatpak update --noninteractive
  code=$?; test $code -lt $exit_code || exit_code=$code
  test $code -eq 0 || echo "=> returned $code"
fi

if [ -x "$(command -v snap)" ]
then
  echo
  echo "--== Updating Snap packages ==--"
  sudo killall snap-store
  sudo snap refresh
  code=$?; test $code -lt $exit_code || exit_code=$code
  test $code -eq 0 || echo "=> returned $code"
fi

if [ -d "$BREW" -a -x "$(command -v brew)" ]; then
  echo
  echo "--== Updating Homebrew packages ==--"
  brew update
  brew upgrade
  code=$?; test $code -lt $exit_code || exit_code=$code
  test $code -eq 0 || echo "=> returned $code"

  if [ "$(uname)" = Darwin ] && command -v fixapps >/dev/null; then
    echo
    echo "--== Resetting stale TCC grants ==--"
    fixapps
    code=$?; test $code -lt $exit_code || exit_code=$code
    test $code -eq 0 || echo "=> returned $code"
  fi
fi

if [ -x "$(command -v scoop)" ]; then
  echo
  echo "--== Updating Scoop packages ==--"
  scoop update && scoop update '*'
  code=$?; test $code -lt $exit_code || exit_code=$code
  test $code -eq 0 || echo "=> returned $code"
fi

if [ -x "$(command -v winget)" ]; then
  echo
  echo "--== Updating winget packages ==--"
  winget upgrade --all --silent --accept-package-agreements \
    --accept-source-agreements --disable-interactivity
  code=$?; test $code -lt $exit_code || exit_code=$code
  test $code -eq 0 || echo "=> returned $code"
fi

# Note: This picks up packages newly added to the manifest,
# and reruns custom installers whose pinned versions were bumped.
if [ -d "$DOTFILES" ]; then
  echo
  echo "--== Installing packages from the manifest ==--"
  "$DOTFILES/bin/system/install-packages"
  code=$?; test $code -lt $exit_code || exit_code=$code
  test $code -eq 0 || echo "=> returned $code"
fi

# Note: Only an installer-made uv can update itself;
# a Homebrew uv is upgraded along with the other formulae.
if [ -f "${XDG_CONFIG_HOME:-$HOME/.config}/uv/uv-receipt.json" ]; then
  echo
  echo "--== Updating uv ==--"
  uv self update
  code=$?; test $code -lt $exit_code || exit_code=$code
  test $code -eq 0 || echo "=> returned $code"
fi

if [ -x "$(command -v uv)" ]; then
  echo
  echo "--== Updating uv tools ==--"
  uv tool upgrade --all
  code=$?; test $code -lt $exit_code || exit_code=$code
  test $code -eq 0 || echo "=> returned $code"
fi

. "$DOTFILES/lib/node.sh"
if [ -n "$(global_node_bin)" ]; then
  echo
  echo "--== Updating global npm packages ==--"
  global_npm update -g $(allow_scripts_option)
  code=$?; test $code -lt $exit_code || exit_code=$code
  test $code -eq 0 || echo "=> returned $code"
fi

echo
echo "--== Done ==--"

exit $exit_code
