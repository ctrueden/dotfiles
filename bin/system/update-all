#!/bin/sh

# Note: Abort the whole run on ^C, not just the step that was interrupted.
# Otherwise sudo's cancelled password prompt fails that step and the rest continue.
trap 'echo; echo "Interrupted."; exit 130' INT

# Note: Windows package managers prompt for elevation themselves, when needed,
# and nothing below needs sudo on FreeBSD.
case "$(uname)" in
  Linux|Darwin) sudo -v || exit 1 ;;
  FreeBSD|MINGW*|MSYS*|CYGWIN*) ;;
  *) echo "Unsupported OS: $(uname)" >&2; exit 1 ;;
esac

has() { command -v "$1" >/dev/null; }

heading() { echo; echo "--== $1 ==--"; }

exit_code=0

# Reports a failure of the command just run, and remembers the worst exit code.
# Note: It reads that command's exit code from $?, so call it right after.
tally() {
  code=$?
  test $code -eq 0 || echo "=> returned $code"
  test $code -lt $exit_code || exit_code=$code
}

if [ -d "$DOTFILES" ]
then
  heading "Updating dotfiles"
  # Only use fast-forward merge, not rebase. If dotfiles
  # have diverged from remote, this returns non-zero by design.
  (cd "$DOTFILES" &&
    git fetch --all --tags --prune --jobs=10 &&
    git merge --ff --ff-only 'HEAD@{u}')
  tally
fi

if has zpm
then
  heading "Updating zsh plugins"
  zpm up
  tally
fi

if [ -d "$CODE_SCIJAVA/scijava-scripts" ]
then
  heading "Updating SciJava scripts"
  (cd "$CODE_SCIJAVA/scijava-scripts" && git pull --rebase)
  tally
fi

if [ -d "$HOME/.password-store" ] && has pass
then
  heading "Updating password store"
  pass git pull --rebase
  tally
fi

# Note: fwupdmgr fails when there is nothing to update,
# so its exit codes are reported, but not remembered.
if has fwupdmgr; then
  heading "Updating firmware"
  fwupdmgr get-updates
  code=$?; test $code -eq 0 || echo "=> returned $code"
  fwupdmgr update -y --no-reboot-check
  code=$?; test $code -eq 0 || echo "=> returned $code"
fi

if [ -d "$DOTFILES" ]; then
  # Note: pack prints a heading for each package manager it upgrades.
  "$DOTFILES/bin/system/pack" upgrade
  tally

  # Note: This picks up packages newly added to the manifest,
  # and reruns custom installers whose pinned versions were bumped.
  heading "Installing packages from the manifest"
  "$DOTFILES/bin/system/pack" install
  tally
fi

if [ "$(uname)" = Darwin ] && has fixapps; then
  heading "Resetting stale TCC grants"
  fixapps
  tally
fi

heading "Done"

exit $exit_code
