#!/bin/sh

# Manages the packages listed in $DOTFILES/packages: installs those not yet
# present, using as few package manager invocations as possible, or lists
# their status. See pack help for usage.

set -u

here=$(cd "$(dirname "$0")" && pwd)
manifest="$here/../../packages"
custom_dir="$here/../packages"
profile="${XDG_CONFIG_HOME:-$HOME/.config}/dotfiles/sections"

# Note: The custom installers find shared code through DOTFILES,
# which is unset if this runs before the shell config is in place.
export DOTFILES="${DOTFILES:-$(cd "$here/../.." && pwd)}"

. "$DOTFILES/lib/node.sh"
. "$DOTFILES/lib/apt-repo.sh"

has() { command -v "$1" >/dev/null; }

usage() {
  cat <<EOF
Usage: pack COMMAND [OPTIONS]

Manages the packages listed in \$DOTFILES/packages.

Commands:
  install             Install the packages that are not yet present.
  list                List every package relevant to this OS: its status, how
                      it installs, and its sections. Installs nothing.
  help                Show this help.

Options:
  -n, --dry-run       With install, report what would be installed,
                      without installing it.
  --with SECTION      Also enable an opt-in section (see packages manifest).
  --without SECTION   Skip a section, even core.
  --gui               Include entries marked gui, even with no desktop detected.
  --no-gui            Skip entries marked gui, even on a desktop.

The core section is always enabled. Entries marked gui count only on
desktops, unless --gui or --no-gui says otherwise.
The opt-in sections this machine wants are read from the profile file,
$profile, which setup.sh writes.
A section may require others, which are then enabled too.
See the header of the packages file for its syntax.

Statuses shown by list:
  installed       installed, and in an enabled section
  installed-dep   installed only as another package's dependency, and in an
                  enabled section (a run marks it as wanted, so autoremove
                  will not remove it)
  missing         not installed, but would be
  extra           installed, though in no enabled section
  extra-dep       installed only as another package's dependency,
                  and in no enabled section
  inactive        not installed, and in no enabled section
  unavailable     none of its alternatives here can supply it
  unlisted        no entry names it, but devlink links it from a checkout

Its DEVLINK column names the checkout that devlink links it from, if any,
which shadows any installed version.
EOF
}

# -- Parse arguments --

dry_run=
list=
with=$(cat "$profile" 2>/dev/null | tr '\n' ' ')
without=
gui=

case "${1:-}" in
  i|install) ;;
  l|list) list=1 ;;
  h|help|-h|--help) usage; exit ;;
  '') usage >&2; exit 1 ;;
  *) echo "Unknown command: $1 (see pack help)" >&2; exit 1 ;;
esac
shift

while [ $# -gt 0 ]; do
  case "$1" in
    -n|--dry-run)
      test -z "$list" || { echo "--dry-run applies only to install" >&2; exit 1; }
      dry_run=1 ;;
    --with) shift; with="$with ${1:?--with needs a section}" ;;
    --without) shift; without="$without ${1:?--without needs a section}" ;;
    --gui) gui=1 ;;
    --no-gui) gui=0 ;;
    *) echo "Unknown option: $1 (see pack help)" >&2; exit 1 ;;
  esac
  shift
done

# -- Detect package managers and environment --

case "$(uname)" in
  Linux) os=linux ;;
  Darwin) os=macos ;;
  FreeBSD) os=freebsd ;;
  MINGW*|MSYS*|CYGWIN*) os=windows ;;
  *) echo "Unsupported OS: $(uname)" >&2; exit 1 ;;
esac

# The package managers to use, in install order.
KINDS=
case $os in
  windows)
    has scoop && KINDS=scoop
    has winget && KINDS="$KINDS winget"
    ;;
  linux)
    if has apt-get; then
      KINDS=apt
    elif has brew; then
      KINDS="brew cask"
    fi
    ;;
  macos)
    has brew && KINDS="brew cask"
    ;;
  freebsd)
    echo "Note: pkg is not supported yet; installing only npm, uv and custom packages." >&2
    ;;
esac
if [ -z "$KINDS" ] && [ $os != freebsd ]; then
  echo "No supported package manager (apt-get, brew, scoop or winget) found." >&2
  exit 1
fi

scoop_dir=${SCOOP:-$HOME/scoop}

# The package managers that may be installed only during the run,
# so their packages install after those of $KINDS.
LATE_KINDS="npm uv"
test $os = linux && LATE_KINDS="$LATE_KINDS flatpak"

SUDO=sudo
test "$(id -u)" -eq 0 && SUDO=

is_desktop() {
  case $os in macos|windows) return 0 ;; esac
  test -n "${XDG_CURRENT_DESKTOP:-}" && return 0
  for d in /usr/share /usr/local/share; do
    test -d $d/xsessions -o -d $d/wayland-sessions && return 0
  done
  return 1
}

sections=" core $with "
if [ -z "$gui" ]; then
  if is_desktop; then gui=1; else gui=0; fi
fi

# Add the sections that enabled ones require, per headers like [dev: build].
while read -r name deps; do
  case "$sections" in
    *" $name "*) for d in $deps; do sections="$sections$d "; done ;;
  esac
done <<EOF
$(sed -n "s/^\[\([a-z]*\): *\(.*\)\]$/\1 \2/p" "$manifest")
EOF

for s in $without; do
  sections=$(echo "$sections" | sed "s/ $s / /g")
done

# Note: Custom installers put tools in ~/.local/bin, which may not be on the
# PATH yet, e.g. on a fresh machine during setup.sh.
case ":$PATH:" in
  *":$HOME/.local/bin:"*) ;;
  *) PATH="$PATH:$HOME/.local/bin" ;;
esac

# -- Helpers --

tmp=$(mktemp -d) || exit 1
trap 'rm -rf "$tmp"' EXIT

run() {
  echo "+ $*"
  test -n "$dry_run" || "$@"
}

# Names in $1 that do not appear in $2.
difference() { grep -vxFf "$2" "$1"; }

# Lists the wanted names of a kind that are absent from the installed list.
subtract() { # kind
  test -f "$tmp/$1.want" || return 0
  difference "$tmp/$1.want" "$tmp/$1.have"
}

# Lists the custom installers that do not support this OS, per the
# "# Platforms:" line in their headers. Those without one support any OS.
unsupported_customs() {
  for f in "$custom_dir"/install-*; do
    platforms=$(sed -n 's/^# Platforms: *//p' "$f")
    test -n "$platforms" || continue
    case " $platforms " in *" $os "*) ;; *) echo "${f##*/install-}" ;; esac
  done
}

# Lists installed names for a kind, one per line.
installed() {
  case "$1" in
    apt)  dpkg-query -W -f='${db:Status-Abbrev}${Package}\n' 2>/dev/null |
            sed -n 's/^ii  *//p' ;;
    # Note: Formulae and casks from other taps are listed as TAP/NAME,
    # as entries name them.
    brew) brew list --formula --full-name -1 ;;
    cask) brew list --cask --full-name -1 ;;
    scoop)
      for f in "$scoop_dir"/apps/*/current/*install.json; do
        test -e "$f" || continue
        app=${f%/current/*}; app=${app##*/}
        echo "$app"
        # Note: Also list it as BUCKET/NAME, as manifest entries from
        # buckets other than main name it that way.
        sed -n "s|.*\"bucket\": *\"\([^\"]*\)\".*|\1/$app|p" "$f"
      done ;;
    winget)
      # Note: winget's tabular listing truncates long names; its export does not.
      winget export -o "$(cygpath -w "$tmp/winget.json")" \
        --accept-source-agreements --disable-interactivity >/dev/null 2>&1
      sed -n 's/.*"PackageIdentifier" *: *"\([^"]*\)".*/\1/p' \
        "$tmp/winget.json" 2>/dev/null ;;
    # Note: On Windows, npm prints its paths with backslashes.
    npm)  global_npm ls -g --depth=0 --parseable 2>/dev/null | tr '\\' / |
            sed -n 's|.*/node_modules/||p' ;;
    uv)   has uv || return 0
          uv tool list 2>/dev/null | awk '!/^-/ && NF {print $1}'
          # Note: uv tool list omits extras, which manifest names may carry,
          # as in jgo[cli]; the receipt of each tool records them.
          for f in "$(uv tool dir 2>/dev/null)"/*/uv-receipt.toml; do
            test -f "$f" || continue
            tool=${f%/uv-receipt.toml}; tool=${tool##*/}
            sed -n 's/^requirements = \[//p' "$f" | tr '}' '\n' |
              sed -n "s/.*name = \"$tool\", extras = \[\([^]]*\)\].*/$tool[\1]/p" |
              tr -d '" '
          done ;;
    flatpak) has flatpak || return 0
             flatpak list --app --columns=application ;;
  esac
}

# Lists installed names for a kind, minus those installed only as dependencies.
requested() {
  case "$1" in
    apt)  apt-mark showmanual 2>/dev/null ;;
    brew) brew list --formula --installed-on-request --full-name -1 ;;
    # Note: Callers list what is installed first; reuse that (winget is slow).
    *)    cat "$tmp/$1.have" ;;
  esac
}

# Lists which of the names in file $2 are available from manager $1.
available() {
  case "$1" in
    apt)  apt-cache policy $(cat "$2") 2>/dev/null |
            awk '/^[^ ]/ {p=$1; sub(/:$/, "", p)}
                 /Candidate:/ && $2 != "(none)" {print p}' ;;
    brew) brew formulae | grep -xFf "$2" ;;
    # Note: A tap not yet added cannot be checked; assume the best.
    cask) grep / "$2"; brew casks | grep -xFf "$2" ;;
    scoop)
      while IFS= read -r name; do
        case "$name" in
          # Note: A bucket not yet added cannot be checked; assume the best.
          */*) test ! -d "$scoop_dir/buckets/${name%%/*}" ||
                 test -f "$scoop_dir/buckets/${name%%/*}/bucket/${name#*/}.json" ;;
          *) ls "$scoop_dir"/buckets/*/bucket/"$name".json >/dev/null 2>&1 ;;
        esac && echo "$name"
      done < "$2" ;;
    *)    cat "$2" ;;
  esac
}

# Succeeds if an apt source, as ppa:OWNER/NAME or repo:NAME, is set up.
apt_source_ready() { # source
  case "$1" in
    ppa:*) apt_repo_has "launchpad[a-z]*\.net/${1#ppa:}/" ;;
    repo:*) sh "$custom_dir/repo-${1#repo:}" --check ;;
  esac
}

# Sets up an apt source, as ppa:OWNER/NAME or repo:NAME.
# Note: pack updates the package lists itself, once all sources are set up.
add_apt_source() { # source
  case "$1" in
    ppa:*) run $SUDO add-apt-repository -y -n "$1" ;;
    repo:*) run sh "$custom_dir/repo-${1#repo:}" ;;
  esac
}

# Adds the scoop buckets that BUCKET/NAME entries in file $1 come from.
add_buckets() {
  for b in $(sed -n 's|/.*||p' "$1" | sort -u); do
    test -d "$scoop_dir/buckets/$b" || run scoop bucket add "$b"
  done
}

# Prints the install command for a kind and its package list.
install_kind() { # kind names...
  kind=$1; shift
  case "$kind" in
    apt)  run $SUDO apt-get install -y "$@" ;;
    brew) run brew install "$@" ;;
    cask) run brew install --cask "$@" ;;
    # Note: One at a time, as scoop abandons the rest when one fails.
    scoop)
      for p in "$@"; do
        run scoop install "$p" || echo "Failed: scoop install $p" >&2
      done ;;
    # Note: winget's export, which installed() reads, leaves out some Store
    # apps (e.g. Windows Notepad), so ask winget list about each one first.
    winget)
      for p in "$@"; do
        winget list --id "$p" --exact --accept-source-agreements \
          --disable-interactivity >/dev/null 2>&1 && continue
        run winget install --id "$p" --exact --silent \
          --accept-package-agreements --accept-source-agreements \
          --disable-interactivity || echo "Failed: winget install $p" >&2
      done ;;
    npm)  run global_npm install -g $(allow_scripts_option) "$@" ;;
    uv)
      for p in "$@"; do
        py=$(awk -v p="$p" '$1 == p { print $2 }' "$tmp/uv.python")
        run uv tool install ${py:+--python $py} "$p"
      done ;;
    flatpak)
      run flatpak remote-add --user --if-not-exists flathub \
        https://dl.flathub.org/repo/flathub.flatpakrepo &&
        run flatpak install --user -y --noninteractive flathub "$@" ;;
  esac
}

# Marks installed packages of a kind as wanted, so that removing what pulled
# them in, then autoremoving, does not remove them too.
mark_kind() { # kind names...
  kind=$1; shift
  case "$kind" in
    apt)  run $SUDO apt-mark manual "$@" ;;
    brew) run brew tab --installed-on-request "$@" ;;
  esac
}

# Queues the custom installer for a name, unless its --check reports the tool
# installed and current.
queue_custom() { # name
  sh "$custom_dir/install-$1" --check || echo "$1" >> "$tmp/custom.run"
}

# -- Read the manifest --

# Each line of $tmp/entries is an entry relevant to this OS: its section,
# whether that is enabled (1 or 0), then its alternatives usable here, as
# KIND:NAME, in order of preference. An alternative without a name takes
# that of the next one with a name, so apt:fd-find | brew|scoop:fd yields
# brew:fd. Spaces around each | are only for legibility.
# An entry's replaces= token, if any, follows its alternatives.
# An entry marked gui is enabled only when $gui is 1, and its section
# reads as SECTION+gui.
# $tmp/uv.python pairs uv tools with the Python their entries ask for, and
# $tmp/apt.src apt packages with the source, ppa:OWNER/NAME or repo:NAME,
# that their entries ask for.
sed -e 's/#.*//' -e 's/[[:space:]]*|[[:space:]]*/|/g' "$manifest" |
awk -v kinds=" $KINDS $LATE_KINDS custom " -v enabled="$sections" -v gui="$gui" \
  -v unsupported=" $(unsupported_customs | tr '\n' ' ') " \
  -v pyfile="$tmp/uv.python" -v srcfile="$tmp/apt.src" '
  BEGIN { printf "" > pyfile; printf "" > srcfile }
  /^\[/ {
    section = $1
    sub(/^\[/, "", section); sub(/:$/, "", section); sub(/\]$/, "", section)
    next
  }
  NF {
    n = split($1, alt, "|"); name = ""; out = ""
    for (i = n; i >= 1; i--) {
      c = index(alt[i], ":")
      if (c) { kind[i] = substr(alt[i], 1, c - 1); name = substr(alt[i], c + 1) }
      else kind[i] = alt[i]
      if (name == "") {
        print "Warning: skipping entry with no package name: " $1 | "cat >&2"
        next
      }
      named[i] = name
    }
    for (i = 1; i <= n; i++) {
      if (!index(kinds, " " kind[i] " ")) continue
      if (kind[i] == "custom" && index(unsupported, " " named[i] " ")) continue
      out = out " " kind[i] ":" named[i]
      if (kind[i] == "uv")
        for (j = 2; j <= NF; j++)
          if ($j ~ /^python=/) print named[i], substr($j, 8) > pyfile
      if (kind[i] == "apt")
        for (j = 2; j <= NF; j++)
          if ($j ~ /^(ppa|repo)=/) {
            src = $j; sub(/=/, ":", src); print named[i], src > srcfile
          }
    }
    if (out == "") next
    marked = 0
    for (j = 2; j <= NF; j++) {
      if ($j ~ /^replaces=/) out = out " " $j
      if ($j == "gui") marked = 1
    }
    on = index(enabled, " " section " ") && (!marked || gui)
    print section (marked ? "+gui" : ""), (on ? 1 : 0) out
  }
' > "$tmp/entries"

# Installing concerns only the enabled entries; listing concerns them all.
if [ -z "$list" ]; then
  awk '$2 == 1' "$tmp/entries" > "$tmp/enabled"
  mv "$tmp/enabled" "$tmp/entries"
fi

# -- Work out which alternative supplies each entry --

# $tmp/ok lists, as KIND:NAME, the alternatives that can supply their package:
# those installed or available from their manager, and existing custom ones.
# Note: Its first line is a placeholder, so that awk can tell it is first.
echo - > "$tmp/ok"
for kind in $KINDS; do
  awk -v k="$kind:" '{
    for (i = 3; i <= NF; i++)
      if (index($i, k) == 1) print substr($i, length(k) + 1)
  }' "$tmp/entries" | sort -u > "$tmp/$kind.cand"
  test -s "$tmp/$kind.cand" || continue

  installed "$kind" | sort -u > "$tmp/$kind.have"
  requested "$kind" | sort -u > "$tmp/$kind.requested"
  difference "$tmp/$kind.cand" "$tmp/$kind.have" > "$tmp/$kind.absent"
  : > "$tmp/$kind.avail"
  if [ -s "$tmp/$kind.absent" ]; then
    # $tmp/apt.pending pairs absent apt packages with the sources they need
    # that are not set up yet.
    if [ "$kind" = apt ]; then
      awk 'FNR == NR { absent[$1] = 1; next } $1 in absent' \
        "$tmp/apt.absent" "$tmp/apt.src" |
        while read -r name src; do
          apt_source_ready "$src" || echo "$name $src"
        done > "$tmp/apt.pending"
    fi
    if [ -z "$list" ]; then
      case "$kind" in
        apt)
          for src in $(cut -d' ' -f2 "$tmp/apt.pending" | sort -u); do
            add_apt_source "$src" || echo "Failed to set up $src" >&2
          done
          run $SUDO apt-get update ;;
        brew) run brew update ;;
        # Note: Stale buckets have stale hashes, which fail installs.
        scoop) run scoop update; add_buckets "$tmp/$kind.absent" ;;
      esac
    fi
    {
      available "$kind" "$tmp/$kind.absent"
      # Note: A source not yet set up cannot be checked; assume the best.
      if [ "$kind" = apt ] && [ -n "$list$dry_run" ]; then
        cut -d' ' -f1 "$tmp/apt.pending"
      fi
    } | sort -u > "$tmp/$kind.avail"
  fi
  cat "$tmp/$kind.have" "$tmp/$kind.avail" | sed "s|^|$kind:|" >> "$tmp/ok"
done
for f in "$custom_dir"/install-*; do
  echo "custom:${f##*/install-}"
done >> "$tmp/ok"

# Each line of $tmp/chosen is an entry's first alternative that can supply it,
# or else its first alternative: kind, name, section, enabled, and whether
# it can supply it (1 or 0).
# $tmp/superseded lists, as KIND:NAME, the packages that the replaces= tokens
# of enabled entries name, other than the alternative chosen for each.
# Note: Late kinds may be installed only during the run, so they always can.
awk -v superseded="$tmp/superseded" -v late=" $LATE_KINDS " '
  BEGIN { printf "" > superseded }
  FNR == NR { ok[$1] = 1; next }
  {
    pick = $3; can = 0; replaces = ""
    for (i = 3; i <= NF; i++) {
      if ($i ~ /^replaces=/) { replaces = substr($i, 10); continue }
      k = substr($i, 1, index($i, ":") - 1)
      if (!can && (index(late, " " k " ") || ($i in ok))) { pick = $i; can = 1 }
    }
    if ($2 && can) {
      n = split(replaces, r, ",")
      for (i = 1; i <= n; i++) if (r[i] != pick) print r[i] > superseded
    }
    c = index(pick, ":")
    print substr(pick, 1, c - 1), substr(pick, c + 1), $1, $2, can
  }
' "$tmp/ok" "$tmp/entries" > "$tmp/chosen"

# Warns about superseded packages that are still installed,
# with the command to remove them.
report_superseded() {
  found=
  for kind in $KINDS; do
    names=$(sed -n "s/^$kind://p" "$tmp/superseded" | sort -u)
    test -n "$names" || continue
    test -f "$tmp/$kind.have" || installed "$kind" | sort -u > "$tmp/$kind.have"
    names=$(echo "$names" | grep -xFf "$tmp/$kind.have" | tr '\n' ' ')
    names=${names% }
    test -n "$names" || continue
    test -n "$found" || {
      echo
      echo "Warning: these packages are superseded by other installs:"
      found=1
    }
    case "$kind" in
      apt)    echo "  $SUDO apt-get remove $names && $SUDO apt-get autoremove" ;;
      brew)   echo "  brew uninstall $names && brew autoremove" ;;
      cask)   echo "  brew uninstall --cask $names" ;;
      scoop)  echo "  scoop uninstall $names" ;;
      winget) for p in $names; do echo "  winget uninstall --id $p --exact"; done ;;
    esac
  done >&2
}

# -- List --

# Prints the checkout that ~/bin/NAME links into, if devlink made it,
# with ~ for the home folder.
devlink_checkout() { # name
  test -L "$HOME/bin/$1" && test -x "$HOME/bin/$1" || return 1
  target=$(readlink "$HOME/bin/$1")
  dir=$(cd "$HOME/bin" && cd "$(dirname "$target")" 2>/dev/null && pwd -P) ||
    return 1
  code=${CODE_BASE:-$HOME/code}
  code_phys=$(cd "$code" 2>/dev/null && pwd -P) || return 1
  case "$dir/" in "$code_phys"/*) ;; *) return 1 ;; esac
  # Note: The link may point into the checkout's build output, e.g. .venv/bin.
  top=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || top=$dir
  top=$code${top#"$code_phys"}
  case "$top/" in "$HOME"/*) top="~${top#"$HOME"}" ;; esac
  echo "$top"
}

# Prints each package relevant to this OS, with its status, kind and sections.
list_packages() {
  for kind in $LATE_KINDS; do
    grep -q "^$kind " "$tmp/chosen" || continue
    installed "$kind" | sort -u > "$tmp/$kind.have"
    requested "$kind" | sort -u > "$tmp/$kind.requested"
  done

  # Merge each package's sections into one line, in manifest order:
  # kind name sections enabled can.
  awk '
    {
      k = $1 " " $2
      if (!(k in secs)) { order[++count] = k; secs[k] = $3; can[k] = $5 }
      else if (index("," secs[k] ",", "," $3 ",") == 0) secs[k] = secs[k] "," $3
      if ($4) act[k] = 1
    }
    END {
      for (i = 1; i <= count; i++)
        print order[i], secs[order[i]], (order[i] in act) ? 1 : 0, can[order[i]]
    }
  ' "$tmp/chosen" > "$tmp/list"

  if [ -t 1 ] && [ -z "${NO_COLOR:-}" ]; then
    esc=$(printf '\033')
    off="$esc[0m"
  else
    esc= off=
  fi
  color() { test -n "$esc" && printf '%s[%sm' "$esc" "$1"; }

  w=$(awk 'length($3) > w { w = length($3) } END { print w + 2 }' "$tmp/list")
  test "$w" -ge 10 || w=10
  row() { # color status kind name sections checkout
    printf "%s%-16s%s%-8s%-36s%-${w}s%s\n" "$(color $1)" "$2" "$off" "$3" "$4" "$5" "$6" |
      sed 's/ *$//'
  }

  row 0 STATUS KIND NAME SECTIONS DEVLINK
  : > "$tmp/devlinked"
  while read -r kind name secs enabled can; do
    if grep -qxF "$name" "$tmp/$kind.requested" 2>/dev/null; then
      status=installed
    elif grep -qxF "$name" "$tmp/$kind.have" 2>/dev/null; then
      status=installed-dep
    elif [ "$can" = 0 ]; then
      status=unavailable
    elif [ "$kind" = custom ]; then
      if sh "$custom_dir/install-$name" --check >/dev/null 2>&1
      then status=installed
      else status=missing
      fi
    else
      status=missing
    fi
    if [ "$enabled" = 0 ]; then
      case "$status" in
        installed) status=extra ;;
        installed-dep) status=extra-dep ;;
        missing) status=inactive ;;
      esac
    fi
    # Note: Extras, as in jgo[cli], are not part of the command name.
    checkout=$(devlink_checkout "${name%%\[*}") &&
      echo "${name%%\[*}" >> "$tmp/devlinked"
    case "$status" in
      installed*) c=32 ;; missing) c=33 ;; extra*) c=36 ;; inactive) c=2 ;;
      *) c=31 ;;
    esac
    row $c "$status" "$kind" "${name##*/}" "$secs" "$checkout"
    echo "$status" >> "$tmp/statuses"
  done < "$tmp/list"

  # Devlinks that no entry names.
  awk '{
    for (i = 3; i <= NF; i++)
      if ($i !~ /^replaces=/) {
        n = $i; sub(/^[^:]*:/, "", n); sub(/\[.*/, "", n); print n
      }
  }' "$tmp/entries" | sort -u > "$tmp/names"
  for f in "$HOME"/bin/*; do
    name=${f##*/}
    grep -qxF "$name" "$tmp/names" && continue
    checkout=$(devlink_checkout "$name") || continue
    echo "$name" >> "$tmp/devlinked"
    row 35 unlisted - "$name" "" "$checkout"
    echo unlisted >> "$tmp/statuses"
  done

  echo
  sort "$tmp/statuses" | uniq -c |
    awk -v d="$(wc -l < "$tmp/devlinked")" '
      { printf "%s%s %s", sep, $1, $2; sep = ", " }
      END { if (d) printf "; %d devlinked", d; print "" }
    '
}

test -n "$list" && { list_packages; report_superseded; exit; }

# -- Work out what is missing --

while read -r kind name section enabled can; do
  if [ "$can" = 1 ]; then
    echo "$name" >> "$tmp/$kind.want"
  else
    echo "Warning: nothing here can supply '$name' ($kind); skipping." >&2
  fi
done < "$tmp/chosen"

for f in "$tmp"/*.want; do
  test -e "$f" && sort -u "$f" -o "$f"
done

: > "$tmp/custom.run"
for kind in $KINDS; do
  test -f "$tmp/$kind.want" || continue
  grep -xFf "$tmp/$kind.have" "$tmp/$kind.want" |
    difference - "$tmp/$kind.requested" > "$tmp/$kind.unmarked"
  subtract "$kind" > "$tmp/$kind.missing"
done

if [ -f "$tmp/custom.want" ]; then
  while IFS= read -r name; do
    queue_custom "$name"
  done < "$tmp/custom.want"
fi

# -- Install, in dependency order --

did=
for kind in $KINDS; do
  test -s "$tmp/$kind.unmarked" 2>/dev/null || continue
  mark_kind "$kind" $(cat "$tmp/$kind.unmarked") || exit 1
  did=1
done

for kind in $KINDS; do
  test -s "$tmp/$kind.missing" 2>/dev/null || continue
  install_kind "$kind" $(cat "$tmp/$kind.missing") || exit 1
  did=1
done

if [ -s "$tmp/custom.run" ]; then
  for name in $(sort -u "$tmp/custom.run"); do
    run sh "$custom_dir/install-$name" || echo "Failed: install-$name" >&2
  done
  did=1
fi

# Late kinds come after, as the managers themselves may have just been installed.
for kind in $LATE_KINDS; do
  test -f "$tmp/$kind.want" || continue
  # Note: In dry-run mode, a manager not yet installed yields no listing.
  installed "$kind" | sort -u > "$tmp/$kind.have"
  subtract "$kind" > "$tmp/$kind.missing"
  test -s "$tmp/$kind.missing" || continue
  case "$kind" in
    npm) manager=$(global_node_bin) ;;
    *) manager=$(command -v "$kind") ;;
  esac
  test -n "$manager" || {
    echo "Skipping $kind packages: $kind is not installed." >&2
    continue
  }
  install_kind "$kind" $(cat "$tmp/$kind.missing")
  did=1
done

test -n "$did" || echo "All packages are already installed."

report_superseded

# Note: nvm sets a default on its first install, after which its Node comes
# first in new shells, hiding the global npm packages installed above.
nvm_default=$(cat "${NVM_DIR:-$HOME/.nvm}/alias/default" 2>/dev/null)
if [ -n "$(global_node_bin)" ] && [ -n "$nvm_default" ] &&
  [ "$nvm_default" != system ]
then
  echo "Warning: nvm's default Node is $nvm_default, so new shells use it" >&2
  echo "rather than the Node that owns global npm packages." >&2
  echo "Run \`nvm alias default system\` to fix that." >&2
fi
