#!/bin/sh
# Find .app bundles whose TCC permission grants have gone stale, and reset
# those grants via fixapp so macOS re-prompts instead of silently denying.
#
# Background: TCC pins each permission grant to a code requirement (csreq)
# captured when the grant was made. For ad-hoc signed apps (no Developer
# ID / certificate), that requirement is just the binary's cdhash, so any
# rebuild (e.g. via `brew upgrade --cask`) invalidates it. For properly
# signed apps, it is usually the designated requirement (bundle ID + team
# ID), which survives updates -- unless the signing identity changes, e.g.
# an app that switches from ad-hoc to Developer ID signing, or to a new
# team. Either way, System Settings still shows the permission toggled
# on, but the app is nonetheless denied (errAEEventNotPermitted / -1719)
# until you re-grant it by hand.
# See: https://nick-liu.com/posts/tcc-cdhash-trap/
#
# This script detects that mismatch by asking codesign whether each app
# still satisfies the csreq TCC has on file for its bundle ID, and calls
# fixapp to reset (not re-grant) the permissions so the next launch
# re-prompts cleanly. Since the csreq itself records the app's identity at
# grant time, no snapshot of prior state is needed: this catches apps
# updated by any means (Homebrew, Sparkle, manual reinstall), whenever
# the update happened.
#
# A more persistent alternative exists for ad-hoc apps: re-sign each with
# a stable local code-signing identity (created once via `security` +
# `openssl`), which pins the requirement to a certificate hash instead of
# a cdhash, so it survives rebuilds and you never get re-prompted at all.
# That's more complex to set up and, unlike this script, modifies the
# app's binary/signature, which then deviates from Homebrew's recorded
# hash for the cask and might complicate reinstalls/updates or upstream
# auto-update checks -- so it isn't what this script does.
#
# Requires Full Disk Access for whatever terminal app runs this script,
# since macOS blocks reads of TCC.db without it (even as root).
#
# Usage: fixapps [-n] [-o] [-v[v]]
#   -n  dry run: report stale grants, but do not reset them
#   -o  also report grants whose bundle ID matches no installed app
#   -v  verbose: one line per grant, marked with its status (implies -o):
#         ✓ current  ✗ stale  ⚠ invalid code signature  ∅ app not installed
#   -vv very verbose: also show each grant's requirement and the apps
#       checked against it, with their signatures

usage() {
    echo "Usage: fixapps [-n] [-o] [-v[v]]" >&2
    exit 1
}

dry_run=
orphans=
verbose=0
while getopts nov opt; do
    case "$opt" in
        n) dry_run=1 ;;
        o) orphans=1 ;;
        v) verbose=$((verbose + 1)); orphans=1 ;;
        *) usage ;;
    esac
done
shift $((OPTIND - 1))
[ $# -eq 0 ] || usage

# Describe an app's signature: ad-hoc, its leaf authority, or unsigned.
signature() {
    sig=$(codesign -dvv "$1" 2>&1 |
        sed -n 's/^Authority=//p; s/^Signature=adhoc$/ad-hoc/p' | head -n 1)
    echo "${sig:-unsigned}"
}

# Map a TCC service name to its label in System Settings > Privacy &
# Security, falling back to the service name minus its kTCCService prefix.
label() {
    case "$1" in
        kTCCServiceAccessibility|kTCCServicePostEvent) echo "Accessibility" ;;
        kTCCServiceAddressBook) echo "Contacts" ;;
        kTCCServiceAppleEvents) echo "Automation" ;;
        kTCCServiceBluetoothAlways) echo "Bluetooth" ;;
        kTCCServiceCalendar) echo "Calendars" ;;
        kTCCServiceCamera) echo "Camera" ;;
        kTCCServiceDeveloperTool) echo "Developer Tools" ;;
        kTCCServiceFocusStatus) echo "Focus" ;;
        kTCCServiceListenEvent) echo "Input Monitoring" ;;
        kTCCServiceMediaLibrary) echo "Media & Apple Music" ;;
        kTCCServiceMicrophone) echo "Microphone" ;;
        kTCCServicePhotos) echo "Photos" ;;
        kTCCServiceReminders) echo "Reminders" ;;
        kTCCServiceRemoteDesktop) echo "Remote Desktop" ;;
        kTCCServiceScreenCapture) echo "Screen & System Audio Recording" ;;
        kTCCServiceSpeechRecognition) echo "Speech Recognition" ;;
        kTCCServiceSystemPolicyAllFiles) echo "Full Disk Access" ;;
        kTCCServiceSystemPolicyAppBundles) echo "App Management" ;;
        kTCCServiceSystemPolicyDesktopFolder) echo "Files & Folders: Desktop" ;;
        kTCCServiceSystemPolicyDocumentsFolder) echo "Files & Folders: Documents" ;;
        kTCCServiceSystemPolicyDownloadsFolder) echo "Files & Folders: Downloads" ;;
        kTCCServiceSystemPolicyNetworkVolumes) echo "Files & Folders: Network Volumes" ;;
        kTCCServiceSystemPolicyRemovableVolumes) echo "Files & Folders: Removable Volumes" ;;
        *) echo "${1#kTCCService}" ;;
    esac
}

# Map a comma-separated list of TCC service names to unique labels.
labels() {
    printf '%s\n' "$1" | tr ',' '\n' | while read -r service; do
        label "$service"
    done | awk '!seen[$0]++' | paste -sd ',' - | sed 's/,/, /g'
}

# Accumulate a line of -vv output for the current grant.
detail() {
    details="$details
  $*"
}

# Report the current grant's status: with -v, as a line marked with the
# given symbol (plus details with -vv); otherwise, as the given message
# (if any) on the given file descriptor (default stdout).
report() {
    if [ "$verbose" -ge 1 ]; then
        echo "$1 $bundle_id [$scope] ($labels)${2:+ -- $2}"
        [ "$verbose" -lt 2 ] || [ -z "$details" ] ||
            printf '%s\n' "${details#?}"
    elif [ -n "$3" ]; then
        echo "fixapps: $3" >&"${4:-1}"
    fi
}

systemdb="/Library/Application Support/com.apple.TCC/TCC.db"
userdb="$HOME/Library/Application Support/com.apple.TCC/TCC.db"

if [ ! -r "$systemdb" ]; then
    echo "fixapps: cannot read $systemdb" >&2
    echo "fixapps: grant Full Disk Access to your terminal app in" >&2
    echo "         System Settings > Privacy & Security, then retry." >&2
    exit 1
fi

tmpdir=$(mktemp -d "${TMPDIR:-/tmp}/fixapps.XXXXXX") || exit 1
trap 'rm -rf "$tmpdir"' EXIT
reqfile="$tmpdir/csreq"
stale="$tmpdir/stale"
: > "$stale"

for db in "$systemdb" "$userdb"; do
    [ -r "$db" ] || continue
    [ "$db" = "$systemdb" ] && scope=system || scope=user
    # Note: client_type 0 = bundle ID; 1 = absolute path (not handled here).
    sqlite3 -readonly -separator '|' "$db" \
        "SELECT '$scope', client, hex(csreq), group_concat(service, ',')
         FROM access WHERE client_type=0 AND csreq IS NOT NULL
         GROUP BY client, csreq;"
done | while IFS='|' read -r scope bundle_id csreq services; do
    labels=$(labels "$services")
    details=
    [ "$verbose" -lt 2 ] || detail "services: $services"
    escaped_id=$(printf '%s' "$bundle_id" | sed "s/'/\\\\'/g")
    apps=$(mdfind "kMDItemCFBundleIdentifier == '$escaped_id'" 2>/dev/null |
        grep '\.app$' | grep -v '/\.Trash/')
    if [ -z "$apps" ]; then
        [ -z "$orphans" ] ||
            report ∅ "app not installed" "no app found for $bundle_id ($labels)"
        continue
    fi

    printf '%s' "$csreq" | xxd -r -p > "$reqfile"
    [ "$verbose" -lt 2 ] ||
        detail "requirement: $(csreq -r "$reqfile" -t 2>/dev/null)"

    # Note: If several copies share a bundle ID, any one satisfying the
    # requirement counts as current, to avoid resetting on every run due
    # to some old stray copy.
    satisfied=
    mismatched=
    invalid=
    old_ifs=$IFS
    IFS='
'
    for app in $apps; do
        if codesign --verify -R "$reqfile" "$app" >/dev/null 2>&1; then
            satisfied=1
            result=ok
        # Distinguish a mismatched requirement from a broken signature,
        # which resetting TCC would not fix.
        elif codesign --verify "$app" >/dev/null 2>&1; then
            mismatched=1
            result=MISMATCH
        else
            invalid="$invalid $app"
            result="INVALID SIGNATURE"
        fi
        [ "$verbose" -lt 2 ] || detail "$app: $(signature "$app") => $result"
    done
    IFS=$old_ifs

    if [ -n "$satisfied" ]; then
        report ✓
    elif [ -z "$mismatched" ]; then
        report ⚠ "invalid code signature, skipping" \
            "invalid code signature, skipping $bundle_id:$invalid" 2
    else
        report ✗ "stale" "stale TCC grant detected for $bundle_id ($labels)"
        echo "$bundle_id" >> "$stale"
    fi
done

[ -z "$dry_run" ] || exit 0

sort -u "$stale" | while read -r bundle_id; do
    fixapp "$bundle_id"
done
